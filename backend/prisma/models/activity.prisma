model Activity {
  id           BigInt @id @default(autoincrement())
  name         String
  activityType String @map("activity_type")

  // Activity overall period
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  // Location
  governorateId Int      @map("governorate_id")
  location      String
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  // Existing information
  institution String
  description String @db.Text

  // Capacity and registration fee (SYP)
  capacity           Int
  registrationFeeSyp Decimal @default(0) @map("registration_fee_syp") @db.Decimal(14, 2)

  // CPD points
  attendanceCpdPoints     Decimal @default(0) @map("attendance_cpd_points") @db.Decimal(6, 2)
  participationCpdPoints  Decimal @default(0) @map("participation_cpd_points") @db.Decimal(6, 2)
  minAttendancePercentage Decimal @default(75) @map("min_attendance_percentage") @db.Decimal(5, 2)

  // Activity president
  activityPresidentName String @map("activity_president_name")

  // Existing foreign keys
  specialistId BigInt @map("specialist_id")
  formConfigId BigInt @map("form_config_id")

  // Existing relations
  specialist  Specialist         @relation(fields: [specialistId], references: [id])
  formConfig  ActivityFormConfig @relation(fields: [formConfigId], references: [id])
  governorate Governorate        @relation(fields: [governorateId], references: [id])

  // Sessions, registration and organizations
  sessions      ActivitySession[]
  registrations ActivityRegistration[]
  organizations ActivityOrganization[]

  // Dynamic forms
  customFields       Json @map("custom_fields") @db.JsonB
  formSchemaSnapshot Json @map("form_schema_snapshot") @db.JsonB

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  activitySeriesId BigInt @map("activity_series_id")
  annualSequence   Int    @map("annual_sequence")

  activitySeries ActivitySeries @relation(fields: [activitySeriesId], references: [id])

  @@index([activitySeriesId, createdAt])
  @@index([governorateId])
  @@map("activities")
}
