enum Role {
    SUPERVISOR
    ADMIN
    DOCTOR
}

model User {
    id       BigInt @id @default(autoincrement())
    name     String
    email    String @unique
    password String
    role     Role   @default(DOCTOR)

    doctor Doctor?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
}
