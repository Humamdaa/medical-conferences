model Certificate {
  id                     BigInt @id @default(autoincrement())
  activityRegistrationId BigInt @unique @map("activity_registration_id")

  certificateNumber String   @unique @map("certificate_number")
  filePath          String   @map("file_path")
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Date

  registration ActivityRegistration @relation(fields: [activityRegistrationId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certificates")
}
