model ActivityRegistration {
  id         BigInt @id @default(autoincrement())
  doctorId   BigInt @map("doctor_id")
  activityId BigInt @map("activity_id")

  participationRole ParticipationRole @default(ATTENDEE) @map("participation_role")

  pointsAwarded Decimal @default(0) @map("points_awarded") @db.Decimal(6, 2)

  doctor Doctor @relation(fields: [doctorId], references: [id])

  activity Activity @relation(fields: [activityId], references: [id])

  attendances SessionAttendance[]
  certificate Certificate?
  payments    Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([doctorId, activityId])
  @@index([activityId])
  @@map("activity_registrations")
}

enum ParticipationRole {
  ATTENDEE
  PARTICIPANT
}
