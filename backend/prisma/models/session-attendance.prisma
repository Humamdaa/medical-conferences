model SessionAttendance {
  id             BigInt @id @default(autoincrement())
  sessionId      BigInt @map("session_id")
  registrationId BigInt @map("registration_id")

  checkInAt DateTime @map("check_in_at") @db.Timestamptz(3)

  checkOutAt DateTime? @map("check_out_at") @db.Timestamptz(3)

  session ActivitySession @relation(fields: [sessionId], references: [id])

  registration ActivityRegistration @relation(fields: [registrationId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, registrationId])
  @@index([registrationId])
  @@map("session_attendances")
}
